--- a/backend/tests/extraction_bakeoff/test_structured_output_sees_truncation.py
+++ b/backend/tests/extraction_bakeoff/test_structured_output_sees_truncation.py
@@ -0,0 +1,93 @@
+"""``structured_output_reliability`` must see a typed field that arrived as truncated text.
+
+It did not. On the recorded three-way run it reported **1.0000 ± 0.0** for every candidate, including the
+two opus runs whose ``clusters`` field came back as a 265- and 376-character unparseable string and was
+silently discarded — because the metric asked only "did the call return?" and "did it invent a top-level
+key?", and a malformed *value* answers both questions cleanly. A metric that scores perfect through the
+one structured-output failure that actually happened is 3.0 weight of guaranteed tie.
+
+The payload below is that real one, verbatim. Two paths are pinned, because the metric has to work on
+both: a **live** record, which now carries the schema it offered and is checked against it; and a
+**resumed** record written before the schema was captured, which falls back to the signature the class
+leaves behind (text that opens like JSON and does not parse).
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from eval.extraction.metrics import structured_output_reliability
+from eval.extraction.recording import CallRecord
+from eval.extraction.resume import _call_from_json, _call_to_json
+
+#: Verbatim from bundles/anthropic-opus-5/run-01/_resume/d05_customs_manifest.json.
+TRUNCATED_CLUSTERS = (
+    '[{"member_ids": [1, 7, 10], "evidence": "EXPLICIT_EQUIVALENCE", "licensing_quotes": '
+    '["ORIENT ELECTRO TRADING PVT LTD (formerly ORIENT ELECTRONIC\\n                 TRADING CO -- '
+    'name change ref SECP CUIN 0087762, 2019)", "Consignee ORIENT ELECTRO TRADING (PVT) LTD /'
+)
+COREF_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "clusters": {"type": "array", "items": {"type": "object"}},
+        "contrasts": {"type": "array", "items": {"type": "object"}},
+    },
+}
+
+
+def _coref_call(payload: dict, *, schema: dict | None = COREF_SCHEMA) -> CallRecord:
+    return CallRecord(lane="text", tool_name="cluster_coreferences",
+                      offered_fields=("clusters", "contrasts"), payload=payload, latency_s=0.1,
+                      offered_schema=schema)
+
+
+def test_the_fixture_is_the_real_defect() -> None:
+    assert len(TRUNCATED_CLUSTERS) == 265
+    with pytest.raises(json.JSONDecodeError, match="Unterminated string"):
+        json.loads(TRUNCATED_CLUSTERS)
+
+
+def test_a_truncated_typed_field_is_no_longer_a_perfect_score() -> None:
+    good = _coref_call({"clusters": [], "contrasts": []})
+    bad = _coref_call({"clusters": TRUNCATED_CLUSTERS})
+    # the old checks both pass on it — which is exactly why it scored 1.000
+    assert bad.ok and not bad.invented_fields()
+
+    metric = structured_output_reliability([good, bad])
+    assert metric.value == pytest.approx(0.5)
+    reported = metric.detail["malformed_payloads"]["cluster_coreferences"]
+    assert "clusters" in reported[0] and "array" in reported[0] and "string" in reported[0]
+
+
+def test_a_resumed_record_without_its_schema_still_reports_it() -> None:
+    """Bundles recorded before the schema was captured must not re-score as clean."""
+    legacy = _coref_call({"clusters": TRUNCATED_CLUSTERS}, schema=None)
+    metric = structured_output_reliability([legacy])
+    assert metric.value == pytest.approx(0.0)
+    assert "unparseable JSON text" in metric.detail["malformed_payloads"]["cluster_coreferences"][0]
+
+
+def test_the_schema_survives_the_resume_round_trip() -> None:
+    original = _coref_call({"clusters": TRUNCATED_CLUSTERS})
+    restored = _call_from_json(json.loads(json.dumps(_call_to_json(original))))
+    assert restored.offered_schema == COREF_SCHEMA
+    assert restored.malformed_fields() == original.malformed_fields()
+
+
+@pytest.mark.parametrize("payload", [
+    {"clusters": [], "contrasts": []},
+    {"clusters": [{"member_ids": [1, 2]}]},
+    {"clusters": None, "contrasts": None},   # absence is an answer, not a malformation
+])
+def test_well_formed_payloads_still_score_clean(payload: dict) -> None:
+    assert structured_output_reliability([_coref_call(payload)]).value == pytest.approx(1.0)
+
+
+def test_a_declared_string_field_holding_prose_is_not_a_malformation() -> None:
+    """Only the container boundary is checked — a string slot filled with a string is nobody's business."""
+    schema = {"type": "object", "properties": {"summary": {"type": "string"}}}
+    call = CallRecord(lane="text", tool_name="t", offered_fields=("summary",),
+                      payload={"summary": "a plain sentence"}, latency_s=0.1, offered_schema=schema)
+    assert structured_output_reliability([call]).value == pytest.approx(1.0)
