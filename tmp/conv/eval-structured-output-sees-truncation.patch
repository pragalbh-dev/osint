+    def malformed_fields(self) -> tuple[str, ...]:
+        """Fields whose returned *shape* contradicts the offered schema — the silent-loss class.
+
+        With the schema in hand this is the same container/scalar check the production client now
+        enforces (:mod:`chanakya.toolargs`), so the metric and the pipeline agree by construction on what
+        "malformed" means. Without it — a record written before the schema was captured — it falls back
+        to the signature that class actually leaves behind: a field holding text that opens like JSON and
+        does not parse, i.e. a tool call cut off mid-token. The fallback is narrower, never wider, so it
+        cannot invent a failure on an old record.
+        """
+        if not self.ok:
+            return ()
+        assert self.payload is not None
+        if self.offered_schema:
+            return tuple(v.describe() for v in structural_violations(self.payload, self.offered_schema))
+        out: list[str] = []
